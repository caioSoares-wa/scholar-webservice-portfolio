@inject StateContainers.UsuarioStateContainer estadoUsuario;
@implements IDisposable ;
@inject NavigationManager navigationManager;

<header class="cabecalho">

    <div class="cabecalho-principal">
        <a class="">
            imagem logo escola
        </a>

        <div class="usuario-info">
            
            <label>
                @estadoUsuario?.Usuario?.Cargo
            </label>

            @if (temNotificacao)
            {
                <div class="container-notificacao">
                    <i class="fa-solid fa-bell icone-sino-ativo"></i>
                    <span class="badge-contador">3</span>
                </div>

            }
            else
            {
                <div class="container-notificacao">
                    <i class="fa-regular fa-bell icone-sino-inativo"></i>
                </div>
            }
          

        


            <div class="menu-usuario">

                <div class="container-icone-dropdown">
                <a>
                    imagem usuário
                </a>
                    <a @onclick="AlternarDropdown">
                        <i class="fa-solid fa-caret-down img-dropdown @(exibirDropdown ? "aba-ativa" : "")"></i>
                    </a>
                    @if (exibirDropdown)
                    {
                        <div class="dropdown-menu-usuario">
                            <div class="dropdown-header">
                                <strong>Meu Perfil</strong>
                                @if (estadoUsuario?.Usuario?.Cargo?.ToLower() == "professor")
                                {
                                    <span>Meus Alunos</span>
                                    <span>Minha Turma</span>
                                }
                                else
                                {
                                    <span>Minha Turma</span>   
                                }

                            </div>
                            <div class="dropdown-divider"></div>

                            <button class="botao-sair-dropdown" @onclick="FazerLogout">Sair</button>
                        </div>
                    }
                </div>

                
            </div>

        </div>

    </div>

    <div class="cabecalho-secundario">


    </div>

</header>


@code {

    private bool exibirDropdown = false;
    private string abaAtiva = "inativa";

    private bool temNotificacao = true;




    private void AlternarDropdown()
    {
        exibirDropdown = !exibirDropdown;
    }

    private async Task FazerLogout()
    {
        await estadoUsuario.FazerLogout();
        navigationManager.NavigateTo("/login");
    }

    protected override void OnInitialized()
    {
        estadoUsuario.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        estadoUsuario.OnChange -= StateHasChanged;
    }


}
